STEAM_API_KEY=tu_api_key_de_steam
DATABASE_URL=sqlite:///./steam_roulette.db
CORS_ORIGINS=http://localhost:5173
# Clave para firmar la sesión (cualquier texto largo y al azar). Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# URL pública del frontend (adonde vuelve el login de Steam). En Docker es la misma que la del backend.
FRONTEND_URL=http://localhost:5173
# "production" exige SESSION_SECRET y marca la cookie como segura detrás de HTTPS.
ENVIRONMENT=development
# SteamID64 de los moderadores del foro, separados por coma.
ADMIN_STEAM_IDS=
# Copias de seguridad diarias de la base (vacío = sin copias) y cuántas conservar.
BACKUP_DIR=
BACKUP_KEEP=7
# Mail de contacto que aparece en la política de privacidad y los términos.
CONTACT_EMAIL=
# Formulario de feedback: los comentarios llegan a FEEDBACK_EMAIL. Para que el mail salga hace
# falta una cuenta que lo mande: con Gmail, activá la verificación en dos pasos y creá una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords. Sin esto, los
# comentarios solo quedan guardados en la base (tabla feedback).
FEEDBACK_EMAIL=ruletazo007@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# HowLongToBeat: apagado. Los términos de Ziff Davis (su dueña) prohíben el acceso automatizado,
# así que solo se puede prender con permiso por escrito. Sin HLTB, la duración sale de quienes
# terminaron cada juego en Ruletazo.
HLTB_ENABLED=false
# Monetización (opcional). Links para apoyar: "Nombre|URL" separados por coma.
SUPPORT_LINKS=
# SteamID64 de quienes apoyan el proyecto (insignia "Supporter"), separados por coma.
SUPPORTER_STEAM_IDS=
# Tiendas con link de afiliado en el foro: "Nombre|URL con {query}" separados por coma.
AFFILIATE_STORES=
