# Clave gratis de la Steam Web API: https://steamcommunity.com/dev/apikey
# Vacía, la página anda con la biblioteca de ejemplo (sin cargar perfiles reales).
STEAM_API_KEY=
DATABASE_URL=sqlite:///./steam_roulette.db
CORS_ORIGINS=http://localhost:5173
# Clave para firmar la sesión (cualquier texto largo y al azar). Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# URL pública del frontend (adonde vuelve el login de Steam). En Docker es la misma que la del backend.
FRONTEND_URL=http://localhost:5173
# "production" exige SESSION_SECRET y marca la cookie como segura detrás de HTTPS.
ENVIRONMENT=development
# SteamID64 de los moderadores del foro, separados por coma.
ADMIN_STEAM_IDS=
# Copias de seguridad diarias de la base (vacío = sin copias) y cuántas conservar.
BACKUP_DIR=
BACKUP_KEEP=7
# Mail de contacto que aparece en la política de privacidad y los términos.
CONTACT_EMAIL=ruletazo007@gmail.com
# Formulario de feedback: los comentarios llegan a FEEDBACK_EMAIL. Para que el mail salga hace
# falta una cuenta que lo mande: con Gmail, activá la verificación en dos pasos y creá una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords. Sin esto, los
# comentarios solo quedan guardados en la base (tabla feedback).
# Para avisar a más de una casilla, separalas con comas: FEEDBACK_EMAIL=a@gmail.com,b@gmail.com
FEEDBACK_EMAIL=ruletazo007@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# En servidores que bloquean los puertos de mail (DigitalOcean, por ejemplo) el SMTP no sale.
# Ahí se usa Resend (https://resend.com), que manda por HTTPS: si RESEND_API_KEY está, tiene
# prioridad sobre el SMTP. EMAIL_FROM tiene que ser de un dominio verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=Ruletazo <feedback@ruletazo.app>
# IGDB (de Twitch) para la duración de los juegos: Client ID y secreto de una app registrada en
# https://dev.twitch.tv/console (tipo "Confidencial"). Vacíos = no se le pide nada a IGDB.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# "Lo bueno y lo malo" de las reseñas de Steam: apagado porque Steam dejó de responder ese pedido
# (redirige a su portada desde noviembre de 2026). Prenderlo si vuelve.
REVIEW_HIGHLIGHTS_ENABLED=false
# Monetización (opcional). Links para apoyar: "Nombre|URL" separados por coma.
SUPPORT_LINKS=
# SteamID64 de quienes apoyan el proyecto (insignia "Supporter"), separados por coma.
SUPPORTER_STEAM_IDS=
# Tiendas con link de afiliado en el foro: "Nombre|URL con {query}" separados por coma.
AFFILIATE_STORES=
